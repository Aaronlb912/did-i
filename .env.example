
# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings, then API.
# Without these two the app runs exactly as before: local only, no account.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required before other people sign up. Privacy and terms contact line.
# VITE_LEGAL_EMAIL=
# VITE_LEGAL_OPERATOR=Aaron Bryant

# Optional. Public URL where the web app is hosted (GitHub Pages, etc.).
# Native Android opens this for gem checkout until Play Billing ships.
# Production site and gem checkout fallback on Android.
VITE_WEB_APP_URL=https://did-i.app

# Optional. POST endpoint for crash reports from did-i-broke.
# VITE_REPORT_URL=

# Optional. For applying SQL from the terminal without the dashboard.
# Account settings, Access Tokens. Never commit .env.local.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Optional. Stripe Payment Link per gem pack (web checkout).
# Create a Payment Link in Stripe for each price, then paste the URL.
# VITE_STRIPE_PACK_gems_1=
# VITE_STRIPE_PACK_gems_3=
# VITE_STRIPE_PACK_gems_5=
# VITE_STRIPE_PACK_gems_10=
# VITE_STRIPE_PACK_gems_25=
# VITE_STRIPE_PACK_gems_50=
