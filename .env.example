
# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings, then API.
# Without these two the app runs exactly as before: local only, no account.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Support, privacy, and terms contact (footer and legal pages).
VITE_LEGAL_EMAIL=support@did-i.app

# Optional. Public site URL (marketing). Native Android opens this for gem checkout
# when VITE_WEB_APP_PUBLIC is true. Gem checkout stays off until then.
VITE_WEB_APP_URL=https://did-i.app

# Optional. Serve the web app at /app. Off in production unless you set this to true.
# Local dev serves /app unless you set this to false.
# VITE_WEB_APP_PUBLIC=true

# Public Did I tonight wall (DIT tab). Off in the main app for now.
# VITE_DIT_ENABLED=true

# Optional. POST endpoint for crash reports from did-i-broke.
# VITE_REPORT_URL=

# Optional. For applying SQL from the terminal without the dashboard.
# Account settings, Access Tokens. Never commit .env.local.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Custom SMTP for sign-in codes. Run: node scripts/setup-smtp.mjs
# Sender must be on a domain with SPF and DKIM set at your mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@did-i.app
# SMTP_SENDER_NAME=Did I

# Gem packs sell through in-app purchase only. See docs/iap.md.
# Server secrets (Supabase function gem-iap, not in this file):
# GOOGLE_PLAY_PACKAGE_NAME, GOOGLE_PLAY_SERVICE_ACCOUNT_JSON,
# APPLE_IAP_SHARED_SECRET. Dev only: GEM_IAP_TRUST=1
