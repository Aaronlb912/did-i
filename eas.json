{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EAS_INCLUDE_WIDGETS": "1"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "production-safe": {
      "extends": "production",
      "env": {
        "EAS_INCLUDE_WIDGETS": "0"
      },
      "ios": {
        "image": "sdk-57"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6814688066"
      }
    }
  }
}
