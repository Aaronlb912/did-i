{
  "name": "did-i",
  "private": true,
  "version": "0.0.0",
  "description": "The unanswered question for tonight. Hit DID. Drop src/lib/ into a React app.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bench": "node scripts/bench-night.mjs",
    "test": "node scripts/check.mjs",
    "check": "node scripts/check.mjs && node scripts/bench-night.mjs",
    "lint": "node scripts/lint-store.mjs",
    "typecheck": "tsc -p tsconfig.store.json --noEmit",
    "sweep": "node scripts/sweep.mjs",
    "locales:merge": "node scripts/merge-i18n-additions.mjs",
    "locales:sync": "node scripts/sync-locales.mjs",
    "locales:refresh": "node scripts/merge-i18n-additions.mjs && node scripts/sync-locales.mjs",
    "locales:report": "node scripts/locale-report.mjs",
    "locales:missing": "node scripts/locale-missing.mjs",
    "locales:apply-pass": "node scripts/apply-locale-pass.mjs",
    "theme:sync": "node scripts/sync-theme-tokens.mjs",
    "visual": "node scripts/visual/compare.mjs",
    "visual:serve": "vite --config vite.visual.config.js",
    "db:apply": "node scripts/apply-sql.mjs",
    "db:apply:all": "node scripts/apply-all-sql.mjs",
    "db:audit": "node scripts/audit-sql.mjs",
    "smtp:setup": "node scripts/setup-smtp.mjs",
    "auth:setup": "node scripts/setup-auth.mjs",
    "apple:auth:setup": "node scripts/setup-apple-auth.mjs",
    "google:auth:setup": "node scripts/setup-google-auth.mjs",
    "build:pages": "vite build",
    "expo": "expo start --dev-client",
    "expo:stop": "node scripts/expo-preflight.mjs",
    "expo:dev": "node scripts/expo-preflight.mjs && expo start --dev-client --tunnel",
    "expo:connect": "node scripts/dev-connect.mjs",
    "expo:android": "expo start --dev-client --android",
    "expo:ios": "expo start --dev-client --ios",
    "ios:device": "eas device:create",
    "ios:build": "eas build --profile development --platform ios",
    "ios:plist:pull": "firebase apps:sdkconfig IOS 1:761721517775:ios:260e6ac2533668fdd369ba --project did-i-a235d > GoogleService-Info.plist",
    "ios:preflight": "npm run check",
    "ios:prepare:store": "node scripts/ios-prepare-store.mjs",
    "ios:prepare:store:full": "node scripts/ios-prepare-store.mjs --sweep",
    "ios:build:store": "node scripts/ios-bump-build.mjs && eas build --profile production --platform ios --non-interactive",
    "ios:build:store:first": "node scripts/ios-bump-build.mjs && eas build --profile production --platform ios",
    "ios:build:safe": "node scripts/ios-bump-build.mjs && eas build --profile production-safe --platform ios --non-interactive",
    "ios:build:safe:first": "node scripts/ios-bump-build.mjs && eas build --profile production-safe --platform ios",
    "ios:submit": "eas submit --platform ios --profile production --non-interactive --latest",
    "ios:submit:first": "eas submit --platform ios --profile production --latest",
    "update:prod": "eas update --channel production --environment production",
    "update:internal": "eas update --channel internal --environment production",
    "android": "expo run:android",
    "android:build": "expo run:android --no-bundler"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "^57.0.19",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.1",
    "expo": "^57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "^57.0.2",
    "expo-font": "^57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^5.6.3",
    "expo-linking": "^57.0.10",
    "expo-notifications": "^57.0.20",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-widgets": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.4",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react-native-web": "^0.21.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
