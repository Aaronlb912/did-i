<?xml version="1.0" encoding="utf-8"?>
<!--
  "Hey Google, create lock the back door in Did I" (App Actions CREATE_THING)
  and the long-press app icon shortcut both open didi://add, which prefills the
  Add screen (native/deep-link.js, src/lib/voice-add.js).
-->
<shortcuts
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">
  <!--
    "Hey Google, I did stretch in Did I" / "I didn't stretch in Did I" open
    didi://answer?a=did&q=stretch. The app matches the words to tonight's
    open questions (src/lib/voice-answer.js). Patterns: res/values/arrays.xml.
  -->
  <capability
    android:name="custom.actions.intent.ANSWER_DID"
    app:queryPatterns="@array/answer_did_queries">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="com.aaronbryant.didi"
      android:targetClass="com.aaronbryant.didi.MainActivity">
      <url-template android:value="didi://answer?a=did{&amp;q}" />
      <parameter android:name="question" android:key="q" android:mimeType="https://schema.org/Text" />
    </intent>
  </capability>
  <capability
    android:name="custom.actions.intent.ANSWER_NOPE"
    app:queryPatterns="@array/answer_nope_queries">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="com.aaronbryant.didi"
      android:targetClass="com.aaronbryant.didi.MainActivity">
      <url-template android:value="didi://answer?a=nope{&amp;q}" />
      <parameter android:name="question" android:key="q" android:mimeType="https://schema.org/Text" />
    </intent>
  </capability>

  <capability android:name="actions.intent.CREATE_THING">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="com.aaronbryant.didi"
      android:targetClass="com.aaronbryant.didi.MainActivity">
      <url-template android:value="didi://add{?q}" />
      <parameter android:name="thing.name" android:key="q" android:required="false" />
    </intent>
  </capability>

  <shortcut
    android:shortcutId="add_question"
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutShortLabel="@string/shortcut_add_short"
    android:shortcutLongLabel="@string/shortcut_add_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:data="didi://add"
      android:targetPackage="com.aaronbryant.didi"
      android:targetClass="com.aaronbryant.didi.MainActivity" />
  </shortcut>
  <shortcut
    android:shortcutId="remind_me"
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutShortLabel="@string/shortcut_remind_short"
    android:shortcutLongLabel="@string/shortcut_remind_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:data="didi://open/remind"
      android:targetPackage="com.aaronbryant.didi"
      android:targetClass="com.aaronbryant.didi.MainActivity" />
  </shortcut>
</shortcuts>
