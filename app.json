{
  "expo": {
    "name": "Did I",
    "slug": "did-i",
    "scheme": "didi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./public/icon-512.png",
    "backgroundColor": "#0e1014",
    "splash": {
      "image": "./public/icon-512.png",
      "backgroundColor": "#0e1014",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.aaronbryant.didi",
      "buildNumber": "66",
      "supportsTablet": false,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Did I uses a shake to undo the last tap."
      }
    },
    "android": {
      "package": "com.aaronbryant.didi",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#0e1014"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "030275bb-f42d-47fd-9f6c-4d3c6a76ecc8"
      }
    },
    "owner": "abryant"
  }
}
