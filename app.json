{
  "expo": {
    "name": "Did I",
    "slug": "did-i",
    "scheme": "didi",
    "version": "1.3.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./public/icon-512.png",
    "backgroundColor": "#0e1014",
    "splash": {
      "image": "./public/icon-512.png",
      "backgroundColor": "#0e1014",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.aaronbryant.didi",
      "buildNumber": "83",
      "supportsTablet": false,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aaronbryant.didi",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#0e1014"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./public/icon-512.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#eef1e6",
          "dark": {
            "image": "./public/icon-512.png",
            "backgroundColor": "#0e1014"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "030275bb-f42d-47fd-9f6c-4d3c6a76ecc8"
      }
    },
    "owner": "abryant"
  }
}
