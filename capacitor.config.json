{
  "appId": "com.aaronbryant.didi",
  "appName": "Did I",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "backgroundColor": "#1c1410",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#1c1410",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_lamp",
      "iconColor": "#e6a23c"
    }
  }
}
